# ============================================================
# 数字办公室 (AI-Office) - 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填写你的配置:
#   Linux/Mac: cp .env.template .env
#   Windows:   copy .env.template .env
#
# 所有配置项都有默认值, 仅 LLM_API_KEY 为必填。
# 删掉行首的 # 可以取消注释使用默认值。
# ============================================================

# ==================== LLM 配置 (必填) ====================
# 支持 OpenAI / DashScope / DeepSeek / ModelScope 等兼容 OpenAI API 的服务
# 只需提供兼容的 base_url 和 api_key 即可切换

# 【必填】你的 API Key
LLM_API_KEY=sk-your-api-key-here

# LLM 服务地址 (默认: https://api.openai.com/v1)
# DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:  https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型 ID (默认: gpt-4o-mini)
# DeepSeek: deepseek-chat
# DashScope: qwen-plus
LLM_MODEL_ID=gpt-4o-mini

# LLM 类型 (openai / modelscope, 默认: openai)
# LLM_TYPE=openai

# 生成温度 0.0~1.0 (默认: 0.7)
# LLM_TEMPERATURE=0.7

# ==================== Embedding 配置 (可选) ====================
# 默认复用 LLM 的 API Key 和 URL
# 如需单独指定 (如使用 DashScope 的 embedding 模型):

# Embedding 模型 ID (默认: text-embedding-v3)
# EMBEDDING_MODEL=text-embedding-v3

# Embedding API 地址 (默认: 复用 LLM_BASE_URL)
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding API Key (默认: 复用 LLM_API_KEY)
# EMBEDDING_API_KEY=sk-your-embedding-key

# ==================== 服务器配置 (可选) ====================
# API 监听地址 (默认: 0.0.0.0)
# API_HOST=0.0.0.0

# API 监听端口 (默认: 8000)
# API_PORT=8000

# ==================== 可观测性 (LangSmith) (可选) ====================
# 用于追踪 LLM 调用、Token 统计、Agent 工作流可视化
# 注册免费账号: https://smith.langchain.com
# 获取 API Key: Settings → API Keys
# 不配置则跳过追踪，不影响运行

# LangSmith API Key (必填，启用追踪)
# LANGSMITH_API_KEY=lsv2_pt_xxxxx

# 项目名称 (默认: ai-office)
# LANGSMITH_PROJECT=ai-office

# 服务地址 (默认: https://api.smith.langchain.com)
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 启用追踪 (设置为 true 才生效)
# LANGSMITH_TRACING=true

# LangSmith 代理地址 (国内网络需要配置，否则无法连接)
# 格式: http://127.0.0.1:7890
# LANGSMITH_PROXY=http://127.0.0.1:7890

# ==================== NPC 配置 (可选) ====================
# NPC 状态更新间隔, 单位秒 (默认: 30)
# NPC_UPDATE_INTERVAL=30