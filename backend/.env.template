# ================================
# 数字办公室 - 环境变量配置模板
# ================================
# 复制此文件为 .env 并填写你的配置:
#   cp .env.template .env
# 或:
#   copy .env.template .env

# ================================
# API 服务配置
# ================================
API_HOST=0.0.0.0
API_PORT=8000

# ================================
# LLM 配置 (兼容 OpenAI 格式的 API)
# ================================
# 支持: openai, deepseek, dashscope, modelscope 等
# 只要提供兼容 OpenAI API 的 base_url 即可
LLM_TYPE=openai
LLM_MODEL_ID=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
# LLM_TEMPERATURE=0.7

# ================================
# Embedding 配置 (用于向量记忆检索)
# ================================
# 可选，默认复用 LLM 的 API Key 和 URL
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=your-embedding-api-key

# ================================
# NPC 更新间隔 (秒)
# ================================
NPC_UPDATE_INTERVAL=30